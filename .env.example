# Copy to .env and fill in. ANTHROPIC_API_KEY is required; the rest have defaults.
# GitHub auth is taken from `gh auth token` automatically (run `gh auth login`).

# REQUIRED — your Anthropic API key (the proxy forwards it upstream unchanged).
ANTHROPIC_API_KEY=

# --- study parameters (defaults match the canonical run) ---
REPO=graphql/graphql-js
WINDOW_START=2026-03-01
WINDOW_END=2026-05-31
FILE_PATH=src/execution/execute.ts

# Model held constant across conditions. Blank => recipe default (claude-sonnet-4-6).
MODEL=

# Repetitions per (condition, task). >=3 recommended for mean/variance.
REPS=3

# --- knobs you rarely change ---
PORT=8080                 # local logging-proxy port
MAX_TURNS=25              # hard cap on agent turns per run
RUN_TIMEOUT=420           # per-run wall-clock seconds before kill
ENABLE_ROVER=0            # 1 => also run Condition C (rover CLI, reported separately)
APOLLO_MCP_VERSION=v1.14.0
# CONDITIONS=A1,B         # optional filter; default runs all enabled conditions
