# secrets & local config
.env

# downloaded/rendered artifacts (regenerated by `./bench.sh setup`)
bin/
config/github.graphql
config/*.local.yaml

# run outputs (kept locally for audit; large)
runs/
results/
capture/*.json
capture/SUMMARY.md
# ...but the pinned phase-2 tool surfaces are an INPUT, not an output. They are
# what `capture/check_surfaces.py` compares each capture against, so an ignored
# copy would pin nothing: a fresh clone would have no baseline and the gate would
# silently pass. See PHASE2_PLAN.md §8.3.
!capture/expected-tool-surfaces.json

# macOS
.DS_Store

# python
__pycache__/
*.pyc

# node (phase-2 services)
services/node_modules/

# Fixture bulk is regenerable from committed seeds (`pnpm fixtures`) and runs to
# ~7 MB. manifest.json carries the per-entity sha256, so anyone can regenerate
# and prove they got byte-identical data without the blobs in git.
services/fixtures/*.json
!services/fixtures/manifest.json

# NOTE: services/generated/ IS committed, deliberately. The Python MCP servers
# read those files straight from disk with no build step — openapi_mcp.py parses
# the OpenAPI docs for the M-R1/M-R2 tool surfaces, and supergraph_mcp.py reads
# supergraph.graphql for M-G1 — so committing them lets a fresh clone run all four
# conditions without Node or rover. Staleness is caught by `pnpm test`
# (src/test/codegen.test.ts) and `pnpm verify:supergraph`, not by hoping.
